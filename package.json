{
  "name": "bank-portal-microfrontends",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "bff",
    "e2e"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "jest",
    "build": "npm run build --workspaces --if-present",
    "audit:ci": "npm audit --omit=dev --audit-level=critical"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@testing-library/vue": "^8.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vue/vue3-jest": "^29.2.6",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "sass-loader": "^17.1.1",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vue-loader": "^17.4.2",
    "vue-tsc": "^3.3.14",
    "webpack": "^5.113.0",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0"
  },
  "dependencies": {
    "pinia": "^4.1.0"
  }
}
