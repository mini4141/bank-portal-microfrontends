# BFF
PORT=3000
SESSION_SECRET=dev-only-session-secret-change-me
# Local flags file (used when APPCONFIG_* are unset)
FLAGS_FILE=bff/data/flags.json
# AWS AppConfig (set by Terraform on Lambda; leave empty locally)
APPCONFIG_APPLICATION=
APPCONFIG_ENVIRONMENT=
APPCONFIG_PROFILE=
# Legacy Tomcat
LEGACY_PORT=8081
# Dev servers
ROOT_PORT=9000
# Optional monitoring (no-op when empty)
SENTRY_DSN=
RUM_APP_MONITOR_ID=
RUM_IDENTITY_POOL_ID=
RUM_REGION=ap-southeast-2
